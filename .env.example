# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Host-side URLs, for running the API with `uv run` outside Docker.
# docker compose overrides these to point at its own containers.
DATABASE_URL=postgresql://ticketing:ticketing@localhost:5432/ticketing
REDIS_URL=redis://localhost:6379/0

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Only the triage worker needs this (milestone M2). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
AUTO_RESOLVE_MIN_CONFIDENCE=85
LLM_DAILY_BUDGET=500

SENTRY_DSN=
